---
import Base from '../layouts/Base.astro';
import { languageNames, langs, useTranslations, withBase } from '../i18n/ui';
---

<Base lang="en" title="404" alternates={false}>
  <section class="not-found">
    <h1>404</h1>
    <ul>
      {
        langs.map((l) => (
          <li lang={l}>
            <span>{useTranslations(l)('notFound')}</span>
            <a href={withBase(`/${l}/`)}>{languageNames[l]} →</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
