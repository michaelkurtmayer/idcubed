---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { langs, localize, stripLang, useTranslations, withBase, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  alternates?: boolean;
}

const { lang, title, description, alternates = true } = Astro.props;
const t = useTranslations(lang);
// Language links point at the same page in the other language
// (or at each home page when there is no translated equivalent, e.g. 404).
const path = alternates ? stripLang(Astro.url.pathname) : '/';
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.fullName}`;
const desc = description ?? `${site.name}: ${t('site.tagline')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale: Record<Lang, string> = { en: 'en_US', fr: 'fr_CA' };
// Anywhere but the real domain (the github.io preview), search engines are
// asked not to list the pages, so the copy never competes with the real site.
const preview = Astro.site?.hostname !== 'www.idcubedmodular.com';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {
      alternates && (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(localize(l, path), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(withBase('/'), Astro.site)} />
        </>
      )
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <!-- Link previews (messages, social media): the Knight Building at dusk -->
    <meta property="og:image" content={new URL(withBase('/share.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <script is:inline>
      try { localStorage.setItem('lang', document.documentElement.lang); } catch (e) {}
    </script>
    {
      /* Cloudflare Web Analytics: cookie-free visit counts, published site only */
      site.cloudflareAnalyticsToken && import.meta.env.PROD && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
