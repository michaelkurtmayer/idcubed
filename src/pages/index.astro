---
// The bare address always opens the English site (English is the default,
// Michael, 21 Nov); French is one click away under FR in the header.
import '../styles/global.css';
import { defaultLang, langs, withBase } from '../i18n/ui';
import { site } from '../site';

const target = withBase(`/${defaultLang}/`);
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — {site.fullName}</title>
    {Astro.site?.hostname !== 'www.idcubedmodular.com' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${site.name} — ${site.fullName}`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(withBase('/share.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(withBase(`/${l}/`), Astro.site)} />)}
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body class="chooser">
    <a class="wordmark" href={target}>{site.name}</a>
  </body>
</html>
