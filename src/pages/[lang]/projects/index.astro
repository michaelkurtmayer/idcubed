---
// Projects: a thumbnail of each project (its first image, cropped to 3:2) with
// its name and place below, one per column of the header, so each starts under
// IDCUBED, System, Projects or About. In `order:`, the four North American
// projects (IDCUBED) fill the first row and the four European ones (NKBAK)
// the second. Two per row on narrow windows and phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../../layouts/Base.astro';
import { getProjects } from '../../../lib/projects';
import { langPaths, localize, useTranslations, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects();

const widths = (img: ImageMetadata) => [...[400, 600, 900, 1200].filter((w) => w < img.width), img.width];
---

<Base lang={lang} title={t('nav.projects')}>
  <h1 class="visually-hidden">{t('nav.projects')}</h1>
  <ul class="project-grid">
    {
      projects.map((p, i) => {
        const cover = p.data.images[0].src;
        return (
          <li>
            <a href={localize(lang, `/projects/${p.id}/`)}>
              <Image
                src={cover}
                alt=""
                widths={widths(cover)}
                sizes="(max-width: 899px) 50vw, 25vw"
                quality={85}
                loading={i < 4 ? 'eager' : 'lazy'}
                class="project-thumb"
              />
              <span class="project-name">{p.data.title[lang]}</span>
              <span>{p.data.location[lang]}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
